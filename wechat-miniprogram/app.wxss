page{background:#f3f6fa;color:#172536;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}button::after{border:0}.page{padding:28rpx}.hero{background:linear-gradient(135deg,#10243a,#1769aa);color:#fff;padding:34rpx 30rpx;border-radius:22rpx;margin-bottom:24rpx}.hero-title{font-size:38rpx;font-weight:700}.hero-sub{font-size:23rpx;color:#c8d9e7;margin-top:8rpx}.card{background:#fff;border:1rpx solid #e3eaf1;border-radius:18rpx;padding:26rpx;margin-bottom:20rpx}.section-title{font-size:32rpx;font-weight:700;margin-bottom:10rpx}.muted{font-size:23rpx;color:#68798b;line-height:1.6}.field{margin-top:20rpx}.field-label{display:block;font-size:24rpx;color:#536679;margin-bottom:10rpx}.input,.picker{background:#f8fafc;border:1rpx solid #d7e1eb;border-radius:12rpx;padding:18rpx 20rpx;min-height:48rpx}.primary{background:#1769aa;color:#fff;border-radius:12rpx;font-weight:700;margin-top:24rpx}.secondary{background:#647789;color:#fff;border-radius:12rpx;margin-top:14rpx}.tabs{display:flex;gap:10rpx;margin-bottom:20rpx}.tab{flex:1;background:#e8eef4;color:#40566b;border-radius:12rpx;text-align:center;padding:17rpx 4rpx;font-size:24rpx}.tab.active{background:#1769aa;color:#fff}.result{background:#eef6fc;border:1rpx solid #d6e8f6;border-radius:14rpx;padding:22rpx;margin-top:20rpx}.result-main{font-size:36rpx;font-weight:700;color:#135d91}.result-line{font-size:24rpx;margin-top:10rpx;line-height:1.6}.warning{background:#fff8ee;border-left:6rpx solid #e2a24d;padding:18rpx;margin-top:20rpx;font-size:22rpx;color:#75572e;line-height:1.6}.history-item{border-top:1rpx solid #e3eaf1;padding:18rpx 0;font-size:23rpx;line-height:1.6}.footer{text-align:center;color:#8190a0;font-size:21rpx;padding:22rpx 0}